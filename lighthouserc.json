{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/lhci",
      "url": ["http://localhost/portfolio-site/", "http://localhost/portfolio-site/gallery/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--disable-gpu --no-sandbox --disable-dev-shm-usage --headless"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
